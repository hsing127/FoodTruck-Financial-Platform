# Environment Configuration for FoodTruck Financial Platform

# Application Environment
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/foodtruck_db"

# For AWS RDS (Production)
# DATABASE_URL="postgresql://username:password@your-rds-endpoint:5432/foodtruck_db"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=12

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS S3 Configuration
S3_BUCKET_NAME=foodtruck-receipts
S3_REGION=us-east-1

# AWS SES Configuration (Email Service)
SES_FROM_EMAIL=noreply@yourfoodtruck.com
SES_REGION=us-east-1

# AWS Textract Configuration
TEXTRACT_REGION=us-east-1

# Email Verification
VERIFICATION_CODE_EXPIRES_IN=15m
RESET_PASSWORD_EXPIRES_IN=1h

# File Upload Configuration
MAX_FILE_SIZE=10mb
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging Configuration
LOG_LEVEL=info

# Health Check Configuration
HEALTH_CHECK_ENABLED=true

# Development Database (Local PostgreSQL)
# Make sure to create a local PostgreSQL database named 'foodtruck_db'
# Run: createdb foodtruck_db